# cinnamon-rocky10.repo — local DNF repository for Cinnamon 6.7.x on Rocky Linux 10
#
# Reference copy of the file that setup-repo.sh writes to
# /etc/yum.repos.d/cinnamon-rocky10.repo. The baseurl below is the
# sample clone path as the script renders it; on your machine it is
# the absolute path of your clone plus /rpms, and it must point to a
# directory that contains valid createrepo_c metadata (repodata/
# subdirectory).
#
# There is no gpgkey= line on purpose: setup-repo.sh imports the
# public key into the rpm keyring, and dnf verifies against that
# keyring under gpgcheck=1 (TASK-0024 D3).
#

[cinnamon-rocky10]
name=Cinnamon for Rocky Linux 10 (local)
baseurl=file:///home/howard/cinnamon-for-rocky10/rpms
enabled=1
gpgcheck=1
metadata_expire=0
module_hotfixes=0
keepcache=0
